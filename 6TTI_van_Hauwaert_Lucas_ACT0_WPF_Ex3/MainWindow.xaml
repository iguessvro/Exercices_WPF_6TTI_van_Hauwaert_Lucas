<Window x:Class="_6TTI_van_Hauwaert_Lucas_ACT0_WPF_Ex3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_6TTI_van_Hauwaert_Lucas_ACT0_WPF_Ex3"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Column="0" Grid.Row="0">
            <Button Height="100" Content="Bouton 1"/>
            <Button Height="100" Content="Bouton 2"/>
        </StackPanel>
        <DockPanel Grid.Column="1" Grid.Row="0">
            <Button DockPanel.Dock="Top" Height="50" Content="Top"/>
            <Button DockPanel.Dock="Bottom" Height="50" Content="Bottom"/>
            <Button DockPanel.Dock="Left" Width="50" Content="Left"/>
            <Button DockPanel.Dock="Right" Width="50" Content="Right"/>
            <Button Content="Center"/>
        </DockPanel>
        <WrapPanel Grid.Column="0" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Button Width="125" Content="Bouton 1"/>
            <Button Width="125" Content="Bouton 2"/>
            <Button Width="125" Content="Bouton 3"/>
            <Button Width="125" Height="70" Content="Bouton 4"/>
            <Button Width="125" Content="Bouton 5"/>
            <Button Width="125" Content="Bouton 6"/>
        </WrapPanel>
        <Canvas Grid.Column="1" Grid.Row="1">
            <Ellipse Width="150" Height="150" Fill="Black" Canvas.Left="120" Canvas.Top="35"/>
            <Ellipse Width="100" Height="100" Fill="Yellow" Canvas.Left="145" Canvas.Top="60"/>
            <Ellipse Width="50" Height="50" Fill="Red" Canvas.Left="170" Canvas.Top="85"/>
        </Canvas>
    </Grid>
</Window>
